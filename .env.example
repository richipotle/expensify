# Copiar este archivo a .env y ajustar los valores localmente.
# NUNCA subir el archivo .env (con valores reales) al control de versiones.

# Clave secreta de Django. Generar una nueva y aleatoria para cada entorno real.
SECRET_KEY=change-me-to-a-random-secret-key

# Activar/desactivar el modo debug de Django (usar False en producción).
DEBUG=True

# Entorno de ejecución: 'development' (default) o 'production'.
DJANGO_ENV=development

# Cadena de conexión a la base de datos (usada en producción, ver config/settings.py).
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Credenciales del superusuario por defecto creado por create_default_admin.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-me-please
